SECRET_KEY=replace-with-a-long-random-value
SECURITY_PASSWORD_SALT=replace-with-a-different-random-value
MONGODB_URI=mongodb://127.0.0.1:27017/metamuseum
MONGODB_DB=metamuseum
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5173","http://localhost:5173"]
FRONTEND_ROOT=frontend/dist
MEDIA_ROOT=backend/metamuseum/static
WALL_MEDIA_ROOT=wall_media
STREAM_ROOT=streams
# Optional private preview; use only assets you may provide to recipients.
# Keep the password in the server environment, never in frontend code or Git.
GAUSSIAN_AVATAR_REMOTE_ENABLED=false
GAUSSIAN_AVATAR_HOSTS=["127.0.0.1","localhost","::1"]
# GAUSSIAN_AVATAR_ROOT=/private/authorized-avatar-package
# LAM_AVATAR_ROOT=/private/generated-lam/preview
# LAM shares the preview host allowlist, remote opt-in and PIN session above.
# GAUSSIAN_AVATAR_ACCESS_PIN=set-a-temporary-password-on-the-server
FFMPEG_PATH=ffmpeg
